generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  packageName String
  engine      String // "flutter" | "native"
  icon        String? // data URL (image/png base64)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  files       ProjectFile[]
  builds      Build[]

  @@map("projects")
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String // "lib/main.dart", no leading slash, no ".."
  isFolder  Boolean  @default(false)
  content   String?
  encoding  String   @default("utf8") // "utf8" | "base64"
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

model Build {
  id        String   @id @default(cuid())
  projectId String
  status    String   @default("queued") // queued | uploading | building | success | failed
  message   String?
  runId     BigInt? // GitHub Actions run id (angka besar)
  runUrl    String?
  headSha   String?
  apkName   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("builds")
}
